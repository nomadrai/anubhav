{
  "name": "anubhav",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint . --ignore-pattern 'e2e/results/**' --ignore-pattern 'e2e/performance-results/**'",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:browser": "playwright test",
    "test:layout": "playwright test e2e/layout.e2e.ts",
    "screenshots:contact": "node e2e/contact-sheet.mjs",
    "check:performance": "node e2e/performance.mjs",
    "check:content": "node scripts/check-content.mjs",
    "check:bundle": "node scripts/check-bundle-size.mjs",
    "check:release": "node scripts/check-release.mjs",
    "release": "npm run lint && npm run typecheck && npm run test && npm run check:content && npm run build && npm run check:bundle && npm run check:release"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "vite": "latest",
    "vite-plugin-pwa": "latest"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "latest",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@typescript-eslint/eslint-plugin": "latest",
    "@typescript-eslint/parser": "latest",
    "autoprefixer": "latest",
    "eslint": "latest",
    "eslint-plugin-react-hooks": "latest",
    "eslint-plugin-react-refresh": "latest",
    "jsdom": "latest",
    "lighthouse": "13.5.0",
    "postcss": "latest",
    "prettier": "latest",
    "tailwindcss": "latest",
    "typescript": "latest",
    "vitest": "latest"
  }
}
